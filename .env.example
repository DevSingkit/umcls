# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# See lib/env.client.ts and lib/env.server.ts for the Zod schemas that
# validate these at startup (split so client-safe vars and server-only
# secrets can't accidentally cross the boundary). Every variable below is
# required by one of those two schemas — if either ever adds/renames one,
# update this file in the same commit, or the mismatch will silently pass
# locally (if .env.local already has the old names cached) and only fail
# on a fresh deploy.

# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SERVER-ONLY, never prefix with NEXT_PUBLIC_.
# This key bypasses Row Level Security entirely. Never expose it to the
# browser. See .eslintrc.js's no-restricted-imports rule, which blocks
# importing lib/supabase/admin.ts from client components as a backstop.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Now in active use — PH9-001 (AI provider abstraction) wires this in.
# Get a key from https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — defaults to gemini-flash-latest in lib/env.server.ts if unset.
# Deliberately using the ALIAS, not a pinned version — gemini-1.5-flash
# and then gemini-2.5-flash were both retired/closed-to-new-keys within
# the same week in 2026. gemini-flash-latest always points at whatever
# Google's current GA flash model is, so this shouldn't need updating
# again just because a specific version gets sunset.
GEMINI_MODEL=gemini-flash-latest

# Upstash Redis (https://upstash.com, free tier) — used for rate limiting.
# V1 needs this for login/password-reset brute-force protection (PH1-001,
# PH1-002); it's not just a V3/AI concern.
# NOTE: these must be the REST URL/token (from Upstash's "REST API"
# panel), not the raw Redis connection string — lib/env.server.ts
# validates UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN specifically.UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Any long random string — gates the /api/health monitoring endpoint so it's
# not publicly guessable. Generate one with: openssl rand -hex 32
MONITOR_SECRET=change-me-to-a-real-random-secret

# The app's own deployed URL. Used by middleware.ts to call
# /api/activity/ping server-to-server. For local dev this is
# http://localhost:3000; for a Vercel deployment, set this to that
# deployment's actual URL (e.g. https://your-project.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
