# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# See lib/env.ts for the Zod schema that validates these at startup.

# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SERVER-ONLY, never prefix with NEXT_PUBLIC_.
# This key bypasses Row Level Security entirely. Never expose it to the
# browser. See .eslintrc.js's no-restricted-imports rule, which blocks
# importing lib/supabase/admin.ts from client components as a backstop.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# V1 note: not used by any V1 feature (AI re-teach generation is PH9-004,
# V3). Fine to leave as a placeholder string until you get to V3 — just
# don't delete the variable, lib/env.ts requires it to be present (even if
# unused) so the app doesn't silently half-start.
GEMINI_API_KEY=placeholder-until-v3

# Upstash Redis (https://upstash.com, free tier) — used for rate limiting.
# V1 needs this for login/password-reset brute-force protection (PH1-001,
# PH1-002); it's not just a V3/AI concern.
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token-here

# Any long random string — gates the /api/health monitoring endpoint so it's
# not publicly guessable. Generate one with: openssl rand -hex 32
MONITOR_SECRET=change-me-to-a-real-random-secret

